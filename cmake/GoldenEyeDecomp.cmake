# Builds the GoldenEye decomp's game code as a static library for the 3DS.
#
# Expects the decomp checked out at external/goldeneye:
#   git submodule add https://github.com/n64decomp/007 external/goldeneye
#
# Directory names below follow the decomp's layout at the time of writing.
# Pin a commit and check them against your checkout.
#
# What gets compiled:
#   - all game C code (src/*.c, src/game, src/inflate)
#   - the portable parts of libultra: audio synthesizer (builds the audio
#     command lists), gu (matrix maths), the printf core, and the VI mode
#     tables, all plain C
# What does NOT:
#   - libultra io/ and os/ (hardware access) -> replaced by src/ultra/*
#   - libultra libc pieces newlib already has (string.c, ldiv.c) and MIPS
#     long-long/float helpers (ll.c, llcvt.c) that GCC provides itself
#   - every .s file -> C replacements in src/ultra/ (os_cpu.c etc.); the
#     game's own .s files (random.s, getra.s, tlb_*.s) still need them
#
# Expect a GE_INTEGRATE=ON build to fail at link until those game-side .s
# replacements exist. Each undefined symbol is one item on that backlog.

set(GE_DECOMP_DIR ${CMAKE_SOURCE_DIR}/external/goldeneye CACHE PATH
    "GoldenEye decomp checkout")

if(NOT EXISTS ${GE_DECOMP_DIR}/src)
    message(FATAL_ERROR
        "GE_INTEGRATE=ON but ${GE_DECOMP_DIR}/src does not exist. "
        "Add the decomp as a submodule at external/goldeneye, or run "
        "builder.py --fetch-decomp.")
endif()

# Assets come from the user's ROM through the decomp's extractor
# (builder.py runs it). Without them, sources that include extracted data
# fail with confusing missing-file errors, so stop here with a clear one.
if(NOT EXISTS ${GE_DECOMP_DIR}/assets/obseg)
    message(FATAL_ERROR
        "Decomp assets not extracted. Run:  python builder.py --rom <your ROM>")
endif()

# Same search path as the decomp's Makefile (INCLUDE and LIBULTRA_INCLUDE).
# The repo root is on it so that `#include "assets/..."` finds the
# extracted assets. compat/decomp goes first: it replaces the one decomp
# libc header that doesn't work with GCC (an empty stddef.h). The decomp's
# other libc-style headers (math.h with M_PI_F etc., assert.h, a
# GCC-aware stdarg.h) are what its code expects, so they stay in front of
# newlib's.
set(GE_DECOMP_INCLUDE_DIRS
    ${CMAKE_SOURCE_DIR}/compat/decomp
    ${GE_DECOMP_DIR}
    ${GE_DECOMP_DIR}/include
    ${GE_DECOMP_DIR}/include/ultra64
    ${GE_DECOMP_DIR}/include/PR
    ${GE_DECOMP_DIR}/src
    ${GE_DECOMP_DIR}/src/game
    ${GE_DECOMP_DIR}/src/inflate
    ${GE_DECOMP_DIR}/src/libultrare
    ${GE_DECOMP_DIR}/src/libultra
)

# The Makefile's LCDEFS for VERSION=US, minus BYTEMATCH (only for
# byte-identical N64 builds). TARGET_N64 is deliberately left out:
# include/platform_info.h and PR/ultratypes.h then take their portable
# paths (endianness detected, size_t/uintptr_t from <stdint.h>).
string(TOUPPER ${GE_VERSION} _ge_version_upper)
if(NOT _ge_version_upper STREQUAL "US")
    message(FATAL_ERROR "Only GE_VERSION=us is set up so far")
endif()
set(GE_DECOMP_DEFINES
    VERSION_US
    LANG_US
    REFRESH_NTSC
    LEFTOVERDEBUG
    LEFTOVERSPECTRUM
    BUGFIX_R0
    TARGET_3DS
    # Predefined by IDO, so the headers assume them. ARM32 has the same
    # int/long/pointer sizes as MIPS o32, so the values carry over.
    _LANGUAGE_C
    _MIPS_SZINT=32
    _MIPS_SZLONG=32
    _MIPS_SZPTR=32
    # libctru also defines osGetTime (different meaning). Rename libultra's
    # in every decomp and shim file so the two never meet at link time.
    osGetTime=ultra_osGetTime
)

file(GLOB_RECURSE GE_DECOMP_SOURCES CONFIGURE_DEPENDS
    ${GE_DECOMP_DIR}/src/*.c
)
# Hardware layers, replaced by src/ultra/.
list(FILTER GE_DECOMP_SOURCES EXCLUDE REGEX "/src/libultra(re)?/(io|os)/")
# libc pieces newlib or GCC already provide.
list(FILTER GE_DECOMP_SOURCES EXCLUDE REGEX "/src/libultra/libc/(string|ldiv|ll|llcvt)[.]c$")
# Asset data compiled from C (Makefile ASSET_DATAFILES and FONTFILES_C),
# generated by the extractor.
file(GLOB GE_FONT_SOURCES CONFIGURE_DEPENDS ${GE_DECOMP_DIR}/assets/font/*.c)
list(APPEND GE_DECOMP_SOURCES
    ${GE_DECOMP_DIR}/assets/oddtextures.c
    ${GE_DECOMP_DIR}/assets/animationtable_data.c
    ${GE_DECOMP_DIR}/assets/animationtable_entries.c
    ${GE_DECOMP_DIR}/assets/font_dl.c
    ${GE_DECOMP_DIR}/assets/font_chardataj.c
    ${GE_DECOMP_DIR}/assets/font_chardatae.c
    ${GE_DECOMP_DIR}/assets/rarewarelogo.c
    ${GE_FONT_SOURCES}
)
# The VI mode tables are data, not hardware access: osViModeTable and the
# per-mode structs the game passes to osViSetMode.
list(APPEND GE_DECOMP_SOURCES
    ${GE_DECOMP_DIR}/src/libultra/io/vimodentsclan1.c
    ${GE_DECOMP_DIR}/src/libultrare/io/vimodepallan1.c
    ${GE_DECOMP_DIR}/src/libultrare/io/vitbl.c
)

add_library(ge_decomp STATIC ${GE_DECOMP_SOURCES})
# texReset() snapshots this file's data between two marker variables
# (image_bank.c), so its definitions must stay in source order.
set_source_files_properties(${GE_DECOMP_DIR}/assets/oddtextures.c
    PROPERTIES COMPILE_OPTIONS -fno-toplevel-reorder)
target_include_directories(ge_decomp PRIVATE ${GE_DECOMP_INCLUDE_DIRS} ${CMAKE_SOURCE_DIR}/include)
target_compile_definitions(ge_decomp PRIVATE ${GE_DECOMP_DEFINES})
target_compile_options(ge_decomp PRIVATE
    -fms-extensions        # unnamed struct members as "inheritance" (IDO -woff 838)
    -fpermissive           # GCC 14+ made legacy-C diagnostics errors; IDO-era code needs them as warnings
    -O2
    -fno-strict-aliasing   # decomp code type-puns freely
    -fwrapv                # and relies on wrapping signed arithmetic
    # N64 address 0 is RAM, and IDO-era code reads through NULL and indexes
    # past declared array bounds (x[1], x[-3]); GCC would turn such paths
    # into traps or assume them away.
    -fno-delete-null-pointer-checks
    -fno-isolate-erroneous-paths-dereference
    -fno-aggressive-loop-optimizations
    # IDO's enums are int-sized; arm-none-eabi's are as small as their
    # values. ROM structs with enum fields (setup propdefs) need IDO's
    # layout. Code that shares structs with libctru/citro3d (ge_pal)
    # keeps the default.
    -fno-short-enums
    -fcommon               # IDO-era tentative definitions across files
    -Wreturn-type          # IDO code that "returns" by leaving v0 set; listed, fixed case by case
    -Wno-implicit-function-declaration
    -Wno-int-conversion
    -Wno-incompatible-pointer-types
    -ffunction-sections -fdata-sections
)
