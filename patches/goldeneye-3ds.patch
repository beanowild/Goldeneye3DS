+s32 texChannelsToPixels(u8 *src, s32 width, s32 height, u8 *dst, s32 format)
+{
+    u32 *dst32;
+    u16 *dst16;
+    u8 *dst8;
+    s32 x;
+    s32 y;
+    s32 pos;
+    s32 mult;
+    s32 rgb_width;
+
+    dst32 = (u32 *)dst;
+    dst16 = (u16 *)dst;
+    dst8  = (u8 *)dst;
