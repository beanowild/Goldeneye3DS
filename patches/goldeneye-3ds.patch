+                    break;
+                case ACT_JUMPOUT:
+                    chrlvTickJumpout(self);
+                    break;
+                case ACT_DEAD:
+                    chrlvTickDead(self);
+                    break;
+                case ACT_ATTACK:
+                    chrlvTickAttack(self);
+                    break;
+                case ACT_ATTACKWALK:
+                    chrlvTickAttackWalk(self);
+                    break;
+                case ACT_ATTACKROLL:
+                    chrlvTickAttackRoll(self);
+                    break;
+                case ACT_RUNPOS:
+                    chrlvTickRunPos(self);
+                    break;
+                case ACT_PATROL:
+                    chrlvTickPatrol(self);
+                    break;
+                case ACT_GOPOS:
+                    chrlvTickGoPos(self);
+                    break;
+                case ACT_SURRENDER:
+                    chrlvTickSurrender(self);
+                    break;
+                case ACT_TEST:
+                    chrlvTickTest(self);
+                    break;
+                case ACT_SURPRISED:
+                    chrlvTickSurprised(self);
