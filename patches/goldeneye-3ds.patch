+/* HUD anchors (f3d_gfx_anchor): in play the frame is stretched over the
+ * 5:3 top screen; anchored draws keep the N64's proportions instead. They
+ * nest: an element that sets its own anchor (the ammo counter) keeps it
+ * for the text inside. */
+extern Gfx *f3d_gfx_anchor(Gfx *g, f32 x);
+static s32 s_HudAnchorDepth;
+
+Gfx *textPortAnchorPush(Gfx *gdl, f32 x)
+{
+    if (s_HudAnchorDepth++ == 0)
+    {
+        gdl = f3d_gfx_anchor(gdl, x);
+    }
+    return gdl;
+}
+
+Gfx *textPortAnchorPop(Gfx *gdl)
+{
+    if (--s_HudAnchorDepth == 0)
+    {
+        gdl = f3d_gfx_anchor(gdl, -1.0f);
+    }
+    return gdl;
+}
+
+/* A string is anchored by the end nearest a screen edge: its left end in
+ * the left third, its right end in the right third, else its centre. */
+static Gfx *textAnchorString(Gfx *gdl, s32 x, char *text, struct fontchar *chars, struct font *font, s32 lineheight)
+{
+    s32 textheight, textwidth;
+    f32 centre;
+
+    textMeasure(&textheight, &textwidth, text, chars, font, lineheight);
+    centre = x + textwidth * 0.5f;
+
+    if (centre < 320 / 3)   /* the N64 frame is 320 wide */
+    {
+        return textPortAnchorPush(gdl, (f32) x);
+    }
+    if (centre > 320 * 2 / 3)
+    {
+        return textPortAnchorPush(gdl, (f32) (x + textwidth));
+    }
+    return textPortAnchorPush(gdl, centre);
+}
+
+Gfx *textRender(Gfx *gdl, s32 *x, s32 *y, char *text,
+                struct fontchar *chars, struct font *font, u32 colour,
+                s32 width, s32 height, u32 yOffset, s32 lineheight)
+{
+    gdl = textAnchorString(gdl, *x, text, chars, font, lineheight);
+    gdl = textRenderUnanchored(gdl, x, y, text, chars, font, colour, width, height, yOffset, lineheight);
+    return textPortAnchorPop(gdl);
+}
+
+Gfx *textRenderOutlined(Gfx *gdl, s32 *x, s32 *y,
+                    char *text, struct fontchar *chars, struct font *font,
+                    u32 colour, u32 colour2, s32 width, s32 height,
+                    s32 yOffset, s32 lineheight)
+{
+    gdl = textAnchorString(gdl, *x, text, chars, font, lineheight);
+    gdl = textRenderOutlinedUnanchored(gdl, x, y, text, chars, font, colour, colour2, width, height, yOffset, lineheight);
+    return textPortAnchorPop(gdl);
+}
