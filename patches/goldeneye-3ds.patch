+/*
+ * Endian-neutral access to the fields of a display-list command.
+ *
+ * The bitfield views of Gfx (.dma, .tri, .loadtile, ...) only match the
+ * command layout on big-endian targets, so the union above leaves them
+ * out elsewhere. These work on the two 32-bit words and give the same
+ * values on both, assuming display lists are kept as native words (game
+ * data loaded from ROM is word-swapped on load). Field positions are
+ * Fast3D's (Gdma, Gtri, Gloadtile in this file).
+ */
+#define GFX_CMD(g)       ((s8)((g)->words.w0 >> 24))   /* signed: F3D immediate cmds are < 0 */
+/* Byte n / halfword n of a command as laid out on the N64 (big-endian). */
+#define GFX_BYTE(g, n)   ((u8)(((const u32 *)(g))[(n) >> 2] >> (24 - 8 * ((n) & 3))))
+#define GFX_HALF(g, n)   ((u16)(((const u32 *)(g))[(n) >> 1] >> (16 - 16 * ((n) & 1))))
+#define GFX_DMA_PAR(g)   (((g)->words.w0 >> 16) & 0xFF)
+#define GFX_DMA_LEN(g)   ((g)->words.w0 & 0xFFFF)
+#define GFX_DMA_ADDR(g)  ((g)->words.w1)
+#define GFX_TRI_FLAG(g)  (((g)->words.w1 >> 24) & 0xFF)
+#define GFX_TRI_V(g, n)  (((g)->words.w1 >> (16 - 8 * (n))) & 0xFF)
+#define GFX_SET_BITS(word, shift, width, val) \
+    ((word) = ((word) & ~(((1u << (width)) - 1) << (shift))) | \
+              (((u32)(val) & ((1u << (width)) - 1)) << (shift)))
+#define GFX_LOADTILE_SET_SL(g, v) GFX_SET_BITS((g)->words.w0, 12, 12, v)
+#define GFX_LOADTILE_SET_TL(g, v) GFX_SET_BITS((g)->words.w0, 0, 12, v)
+
