+#ifdef TARGET_3DS
+/*
+ * The animation table comes from ROM in N64 (big-endian) byte order. Swap
+ * it to native order before expand_ani_table_entries() adds base addresses
+ * to its offsets. Layout, checked against the ROM (all 173 entries):
+ *   - a 0x14-byte header per animation (struct ModelAnimation's first
+ *     fields: s32, u16, u8, u8, u32 desc, u16, u16, u32 stream),
+ *   - (stream - desc) / 6 ModelAnimBitFields at table + desc
+ *     (u16 bitOffset, u8, u8, u16 valueOffset). Arrays can be shared
+ *     between animations, so each field is swapped exactly once,
+ *   - the bit stream at table + stream: raw bytes, read big-endian on
+ *     purpose by modelAnimReadRootMotionValue, so left alone.
+ */
+static u8 s_aniSwapped[0x10000 / 8];   /* field starts already swapped */
+
+static int aniClaim(u32 off)
+{
+    u8 bit = 1 << (off & 7);
+    if (s_aniSwapped[off >> 3] & bit)
+        return 0;
+    s_aniSwapped[off >> 3] |= bit;
+    return 1;
+}
+
+static void aniSwap16(u8 *base, u32 off)
+{
+    if (aniClaim(off)) {
+        u8 t = base[off]; base[off] = base[off + 1]; base[off + 1] = t;
+    }
+}
+
+static void aniSwap32(u8 *base, u32 off)
+{
+    if (aniClaim(off)) {
+        u8 *p = base + off, t;
+        t = p[0]; p[0] = p[3]; p[3] = t;
+        t = p[1]; p[1] = p[2]; p[2] = t;
+    }
+}
+
+static void swap_ani_table_entries(s32 *entries)
+{
+    u8 *base = ptr_animation_table->data;
+
+    for (; *entries != 0; entries++) {
+        u32 off = (u32)*entries, desc, stream, d;
+        if (off == 1)
+            continue;   /* "no animation" placeholder */
+        aniSwap32(base, off + 0x00);
+        aniSwap16(base, off + 0x04);
+        aniSwap32(base, off + 0x08);
+        aniSwap16(base, off + 0x0C);
+        aniSwap16(base, off + 0x0E);
+        aniSwap32(base, off + 0x10);
+        desc = *(u32 *)(base + off + 0x08);
+        stream = *(u32 *)(base + off + 0x10);
+        for (d = desc; d + 6 <= stream; d += 6) {
+            aniSwap16(base, d);
+            aniSwap16(base, d + 4);
+        }
+    }
+}
