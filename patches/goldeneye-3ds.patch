+        case TEXFORMAT_I4:
+            for (y = 0; y < height; y++)
+            {
+                for (x = 0; x < width; x += 2)
+                {
+                    dst8[x >> 1] = src[pos] << 4 | src[pos + 1];
+                    pos += 2;
+                }
+
+                if (width & 1) { pos--; }
+
+                dst8 += ((width + 15) & 0xff0) >> 1;
+            }
+
+            return (((width + 15) & 0xff0) >> 1) * height;
+    }
+
+    return 0;
+}
