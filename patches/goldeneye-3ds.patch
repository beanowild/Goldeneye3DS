-		for (y = 1; y < height; y += 2) {
-			for (x = 0; x < alignedwidth; x += 4) {
-				tmp = row[x + 0];
-				row[x + 0] = row[x + 2];
-				row[x + 2] = tmp;
-
-				tmp = row[x + 1];
-				row[x + 1] = row[x + 3];
-				row[x + 3] = tmp;
-			}
-
-			row += alignedwidth * 2;
-		}
-	} else {
-		for (y = 1; y < height; y += 2) {
-			for (x = 0; x < alignedwidth; x += 2) {
-				tmp = row[x + 0];
-				row[x + 0] = row[x + 1];
-				row[x + 1] = tmp;
-			}
