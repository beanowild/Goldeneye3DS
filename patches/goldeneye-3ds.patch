+                {
+                    nextcol = j + 1 < srcwidth ? j + 1 : j;
+
+                    tl16 = src16[j];
+                    tr16 = src16[nextcol];
+                    bl16 = src16[nextrow + j];
+                    br16 = src16[nextrow + nextcol];
+
+                    c = (((tl16 >> 8) & 0xff) + ((tr16 >> 8) & 0xff) + ((bl16 >> 8) & 0xff) + ((br16 >> 8) & 0xff)) >> 2;
+                    a = ((tl16 & 0xff) + (tr16 & 0xff) + (bl16 & 0xff) + (br16 & 0xff) + 1) >> 2;
