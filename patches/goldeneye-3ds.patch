+#ifdef TARGET_3DS
+/*
+ * A demo's header in ROM is big-endian and laid out by IDO: enums are 4
+ * bytes and the struct is padded to 8, 0xE8 bytes in all. GCC's
+ * arm-none-eabi enums are 1-2 bytes, so the native struct is smaller and
+ * shaped differently; build it field by field.
+ */
+#define RAMROM_HEADER_ROM_SIZE 0xE8
+
+static u32 ramromBE32(const u8 *p) { return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+static u64 ramromBE64(const u8 *p) { return ((u64)ramromBE32(p) << 32) | ramromBE32(p + 4); }
+
+static ramromfilestructure *ramromLoadHeader(void *rom)
+{
+    static u8 rawbuf[RAMROM_HEADER_ROM_SIZE + 16];
+    const u8 *raw = (const u8 *)romCopyAligned(rawbuf, rom, RAMROM_HEADER_ROM_SIZE);
+    ramromfilestructure *h = (ramromfilestructure *)ALIGN16_a((s32)ramrom_data_target);
+    s32 i;
+
+    bzero(h, sizeof *h);
+    h->randomseed = ramromBE64(raw + 0x00);
+    h->randomizer = ramromBE64(raw + 0x08);
+    h->stagenum = ramromBE32(raw + 0x10);
+    h->difficulty = ramromBE32(raw + 0x14);
+    h->size_cmds = ramromBE32(raw + 0x18);
+    /* save_data: two checksums, bytes, a u16 of options, bytes */
+    bcopy(raw + 0x1C, &h->savefile, sizeof h->savefile);
+    h->savefile.chksum1 = ramromBE32(raw + 0x1C);
+    h->savefile.chksum2 = ramromBE32(raw + 0x20);
+    h->savefile.options = (u16)((raw[0x28] << 8) | raw[0x29]);
+    h->totaltime_ms = ramromBE32(raw + 0x7C);
+    h->filesize = ramromBE32(raw + 0x80);
+    h->mode = ramromBE32(raw + 0x84);
+    h->slotnum = ramromBE32(raw + 0x88);
+    h->numplayers = ramromBE32(raw + 0x8C);
+    h->scenario = ramromBE32(raw + 0x90);
+    h->mpstage_sel = ramromBE32(raw + 0x94);
+    h->gamelength = ramromBE32(raw + 0x98);
+    h->mp_weapon_set = ramromBE32(raw + 0x9C);
+    for (i = 0; i < 4; i++)
+    {
+        h->mp_char[i] = ramromBE32(raw + 0xA0 + i * 4);
+        h->mp_handi[i] = ramromBE32(raw + 0xB0 + i * 4);
+        h->mp_contstyle[i] = ramromBE32(raw + 0xC0 + i * 4);
+        h->mp_flags[i] = ramromBE32(raw + 0xD4 + i * 4);
+    }
+    h->aim_option = ramromBE32(raw + 0xD0);
+    return h;
+}
