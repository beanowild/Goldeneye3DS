+    s32 r;
+    s32 g;
+    s32 b;
+    s32 a;
+    s32 c;
+    u32 tl32;
+    u32 tr32;
+    u32 bl32;
+    u32 br32;
+    u16 tl16;
+    u16 tr16;
+    u16 bl16;
+    u16 br16;
+    u8 tl8;
+    u8 tr8;
+    u8 bl8;
+    u8 br8;
