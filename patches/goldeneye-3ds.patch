+f32 chrlvGetAimLimitAngle(f32 sqdist)
+{
+    if (sqdist > (1600.0f * 1600.0f))
+    {
+        return (M_PI_F / 167.5f);
+    }
+
+    if (sqdist > (800.0f * 800.0f))
+    {
+        return (M_PI_F / 83.5f);
+    }
+
+    if (sqdist > (400.0f * 400.0f))
+    {
+        return (M_PI_F / 42.0f);
+    }
+
+    if (sqdist > (200.0f * 200.0f))
+    {
+        return (M_PI_F / 21.0f);
+    }
+
+    return (M_PI_F / 12.5f);
+}
