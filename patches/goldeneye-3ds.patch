+                for (x = 0; x < width; x += 2)
+                {
+                    dst8[x >> 1] = src[pos] << 5 | src[pos + mult * 3] << 4 | src[pos + 1] << 1 | src[pos + mult * 3 + 1];
+                    pos += 2;
+                }
