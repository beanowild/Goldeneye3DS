-		if (texReadBits(1) == 0) {
-			// Found a literal directive
-			if (blocksize <= 8) {
-				dst[blocksdone] = texReadBits(blocksize);
-				blocksdone++;
-			} else {
-				u16 *tmp = (u16 *)dst;
-				tmp[blocksdone] = texReadBits(blocksize);
-				blocksdone++;
