+                case ACT_BONDINTRO:
+                    chrlvTickBondIntro(self);
+                    break;
+                case ACT_BONDDIE:
+                    chrlvTickBondDieRemoved(self);
+                    break;
+            }
+
+            self->chrflags &= ~CHRFLAG_NEAR_MISS;
+            self->hidden &= ~(CHRHIDDEN_ALERT_GUARD_RELATED | CHRHIDDEN_BACKGROUND_AI);
+            self->chrseeshot = CHR_FREE;
