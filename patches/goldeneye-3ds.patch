+#ifdef TARGET_3DS
+/*
+ * The images are u32 arrays, so here they compile to native (little-endian)
+ * words; the renderer reads texels in N64 byte order, like everything else
+ * from ROM. Put them in that order once, before the logo is first drawn.
+ */
+void rarewarelogoTexturesToN64Order(void)
+{
+    static s32 done = FALSE;
+    static u32 *const images[] = { imgRAre_0x0020, img_raRE_0x0AE0, imgWAre_0x15A0, imgwaRE_0x2060, D_02004FE8, D_02005FF0 };
+    static const u32 counts[] = { sizeof imgRAre_0x0020 / 4, sizeof img_raRE_0x0AE0 / 4, sizeof imgWAre_0x15A0 / 4,
+                                  sizeof imgwaRE_0x2060 / 4, sizeof D_02004FE8 / 4, sizeof D_02005FF0 / 4 };
+    u32 i, k;
+
+    if (done)
+        return;
+    done = TRUE;
+    for (i = 0; i < sizeof images / sizeof images[0]; i++)
+        for (k = 0; k < counts[i]; k++)
+            images[i][k] = __builtin_bswap32(images[i][k]);
+}
+#endif
