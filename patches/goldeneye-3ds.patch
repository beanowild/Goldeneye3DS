+void chrlvStanLineDirIntersection(coord3d *line2_p3, coord3d *dir, coord3d *result)
+{
+    coord3d sp2C;
+    coord3d sp20;
+
+    getCollisionEdge_maybe(&sp2C, &sp20);
+    chrlvLineLineIntersection(&sp2C, &sp20, line2_p3, dir, result);
+}
