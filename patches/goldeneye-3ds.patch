-        result->f[1] = line2_p3->f[1];
-        result->f[2] = line2_p3->f[2];
-    }
-    else
-    {
-        // all other cases, fallback to Line 1 first point
-        result->f[0] = line1_p1->f[0];
-        result->f[1] = line1_p1->f[1];
-        result->f[2] = line1_p1->f[2];
-    }
-}
