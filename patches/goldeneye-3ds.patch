-            high = paletteidx;
-            low = paletteidx;
-        }
-    }
- 
-    // Stage 3: Search the nearby palette entries accurately. 
-    low = high - 4;
- 
-    if (low < 0)
-    {
-        low = 0;
-    }
- 
