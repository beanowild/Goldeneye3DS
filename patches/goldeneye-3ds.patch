+void chrlvStanPointPointIntersection(coord3d *arg0, coord3d *arg1, coord3d *result)
+{
+    coord3d sp2C;
+    coord3d sp20;
+    f32 v;
+
+    getCollisionEdge_maybe(&sp2C, &sp20);
+
+    // see comments in chrlvLineLineIntersection
