; f3d.v.pica - vertex shader for the F3D interpreter.
;
; Positions arrive in clip space already (the interpreter transforms on
; the CPU, as the N64's RSP did). The work here is turning the landscape
; picture onto the top screen's portrait framebuffer, mapping the RDP's
; texel coordinates onto each texture unit, and the vertex colour.
;
; Per draw state (uniforms, set by gfx_c3d.c), so that a vertex is the
; same whatever state draws it and is written to the GPU once:
;   unit k:  uv = st * tAk + tBk (tile shift, origin and texture size)
;   unit 1:  + (x / w, y / w) * tN1 (G_AC_DITHER's noise: screen pixels)
;   colour:  rgba * cmul + cadd (0-255 to 0-1, or white without G_SHADE)
;   stereo:  x += E * max(A * w - B, M * w), ster = (A, B, M, E): affine
;            in clip space except very near the eye (where M * w wins), so
;            T-junctions in level geometry stay closed (a kink at the
;            screen's depth, 150 units out, opened seams in Dam's tunnel;
;            the kink left is 10 units from the eye, f3d.c STEREO_CONV)
;            (gfx_backend.h GFX_STEREO_*; E: -1 left eye, +1 right)
;
; The rotation is a dp4 per output component, not masked movs: writing
; outpos piecewise with swizzled/negated movs (mov outpos.x, -inpos.y ...)
; drew nothing at all, on Azahar's hardware and software renderers alike.
; For the same reason every other output is written whole.

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inst v1
.alias inclr v2

; in this order: gfx_c3d.c writes them as one run
.fvec tA0, tB0, tA1, tB1, tN1, cmul, cadd
; on its own: the right eye's copy of the frame patches its E
.fvec ster

; framebuffer x runs down the physical screen, y left to right:
; out = (y, -x, z, w)
.constf rot0(0.0, 1.0, 0.0, 0.0)
.constf rot1(-1.0, 0.0, 0.0, 0.0)
.constf rot2(0.0, 0.0, 1.0, 0.0)
.constf rot3(0.0, 0.0, 0.0, 1.0)
.constf zero(0.0, 0.0, 0.0, 0.0)

.proc main
    rcp r7, inpos.wwww
    mul r5, ster.xxxx, inpos.wwww
    add r5, -ster.yyyy, r5
    mul r8, ster.zzzz, inpos.wwww
    max r5, r8, r5
    mul r5, ster.wwww, r5
    mov r6, inpos
    add r6.x, inpos.x, r5.x

    dp4 outpos.x, rot0, r6
    dp4 outpos.y, rot1, r6
    dp4 outpos.z, rot2, r6
    dp4 outpos.w, rot3, r6

    mul r0, cmul, inclr
    add outclr, cadd, r0

    mov r1, zero
    mov r1.xy, inst.xy
    mul r2, tA0, r1
    add outtc0, tB0, r2

    mul r3, inpos, r7
    mov r4, zero
    mov r4.xy, r3.xy
    mul r4, tN1, r4
    mul r2, tA1, r1
    add r2, tB1, r2
    add outtc1, r4, r2
    end
.end
